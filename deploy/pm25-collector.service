# systemd service สำหรับตัวเก็บข้อมูลบน Raspberry Pi 5
# ติดตั้ง:
#   sudo cp deploy/pm25-collector.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now pm25-collector
#
# แก้ไข User, WorkingDirectory และ path ให้ตรงกับเครื่องของคุณ
[Unit]
Description=PM2.5 Sensor Collector (Raspberry Pi 5)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/Hi/device
Environment=BACKEND_URL=http://localhost:8000
Environment=BACKEND_API_KEY=changeme-secret-key
ExecStart=/home/pi/Hi/.venv/bin/python collector.py
Restart=on-failure
RestartSec=15

[Install]
WantedBy=multi-user.target
