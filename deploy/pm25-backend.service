# systemd service สำหรับ Backend (เว็บเซิร์ฟเวอร์)
# ติดตั้ง:
#   sudo cp deploy/pm25-backend.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now pm25-backend
[Unit]
Description=PM2.5 Dashboard Backend (Flask/Gunicorn)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/Hi/backend
Environment=BACKEND_API_KEY=changeme-secret-key
Environment=PORT=8000
ExecStart=/home/pi/Hi/.venv/bin/gunicorn -w 2 -b 0.0.0.0:8000 app:app
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
